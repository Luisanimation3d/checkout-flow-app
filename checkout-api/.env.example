DB_HOST=localhost
DB_PORT=5432
DB_USER=checkout
DB_PASSWORD=changeme
DB_NAME=checkout_db
# Solo en RDS/producción: exige la conexión TLS que Postgres administrado requiere por defecto.
DB_SSL=false

CORS_ORIGIN=http://localhost:5173

PORT=3000

# Credenciales del sandbox del proveedor de pagos (UAT). El backend nunca ve
# datos de tarjeta en texto plano: solo firma/reenvía lo que ya llega tokenizado
# o cifrado (JWE) desde el frontend.
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_PRIVATE_KEY=
PAYMENT_GATEWAY_INTEGRITY_SECRET=
